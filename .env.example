# Sao chép file này thành .env rồi đổi các giá trị bên dưới:
#   cp .env.example .env
# File .env chứa mật khẩu thật — KHÔNG đưa lên Git (đã có trong .gitignore).

# ---- Database PostgreSQL ----
POSTGRES_DB=dapchuot
POSTGRES_USER=dapchuot
POSTGRES_PASSWORD=doi-mat-khau-database-nay

# ---- Admin đầu tiên (chỉ dùng khi database chưa có admin nào) ----
# Tên đăng nhập: 3–32 ký tự, chữ thường/số/. _ -   ·   Mật khẩu: tối thiểu 10 ký tự
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin-nay

# Đặt true khi chạy sau HTTPS để cookie đăng nhập chỉ gửi qua HTTPS
COOKIE_SECURE=false

# ---- Chỉ dùng khi deploy lên Vercel (khai báo trong Project → Settings → Environment Variables) ----
# DATABASE_URL do tích hợp Neon tự thêm — không cần tự gõ. Khi có DATABASE_URL, các biến POSTGRES_* bị bỏ qua.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Tắt bộ đọc body tự động của Vercel để server tự kiểm tra JSON như khi chạy Docker
# NODEJS_HELPERS=0
